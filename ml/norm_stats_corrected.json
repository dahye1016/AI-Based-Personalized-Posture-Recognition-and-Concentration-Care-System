{
  "label_order": [
    "not_sitting",
    "sitting_straight",
    "lean_forward",
    "cross_leg_right",
    "cross_leg_left",
    "lean_right",
    "lean_left"
  ],
  "class_index": {
    "not_sitting": 0,
    "sitting_straight": 1,
    "lean_forward": 2,
    "cross_leg_right": 3,
    "cross_leg_left": 4,
    "lean_right": 5,
    "lean_left": 6
  },
  "num_classes": 7,
  "model_io": {
    "tflite_file": "posture_model_corrected.tflite",
    "input_shape": [
      1,
      128
    ],
    "input_dtype": "float32",
    "input_layout": "값 128개 = [지금 프레임 원시값 ch0~63] + [캘리브레이션 기준값 ch0~63]. 정규화하지 말 것. 기준값은 쓰지 않으므로 0 이어도 됨",
    "output_shape": [
      1,
      7
    ],
    "output": "7자세 확률 (argmax 가 label_order 인덱스). 정자세 보정 포함",
    "keras_vs_tflite_agreement": 1.0
  },
  "raw_input": true,
  "channel_layout": "ch0~31 좌석, ch32~63 등받이",
  "model": {
    "type": "특징(채널 비율 64 + log 합 + 등받이 비율·등받이 왼쪽 비율·오른 무릎 비율) -> MLP 128-64 -> softmax",
    "correction": "argmax 가 lean_left/lean_right 인데 등받이 합>=100, 등받이 왼쪽 비율 5~85%, 무릎 합>=100, 오른 무릎 비율 20~90% 이면 sitting_straight",
    "train_data": {
      "real": "real_27.csv.gz (33716프레임, 27녹화)",
      "dummy": "dummy_30p.csv.gz (1/5 샘플)",
      "flip": "좌우 반전 + 라벨 스왑으로 2배"
    }
  },
